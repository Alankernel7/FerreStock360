# API Express + Firebase Admin (secretos solo en el backend)
DATA_BACKEND=firestore
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=
# Alternativa local: GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/segura/service-account.json
# Pruebas aisladas: FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

PORT=3001
FRONTEND_URLS=http://localhost:3000
# Local: local. Vercel/serverless: firebase + FIREBASE_STORAGE_BUCKET configurado.
STORAGE_DRIVER=local
CRON_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
