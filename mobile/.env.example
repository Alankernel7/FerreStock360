# ---------------------------------------------------------------
# FerreStock360 Mobile - Variables de entorno (Expo)
# Copia este archivo como `.env` y completa los valores reales.
# Los valores EXPO_PUBLIC_* NO son secretos: se empaquetan en la app.
# ---------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# --- Firebase (obtenidos en Firebase Console > Configuración del proyecto > Tus apps) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcionales para Google Sign-In nativo
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Cloudinary: Settings > Upload > Upload presets (modo Unsigned)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu_preset_unsigned
