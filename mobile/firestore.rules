rules_version = '2';

// Web y móvil usan Firebase Authentication para la identidad, pero las
// operaciones de datos se realizan mediante la API Express autenticada.
// El SDK Firebase Admin del servidor no está limitado por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
