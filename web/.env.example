# API compartida del backend Express (incluye /api)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Configuración cliente de Firebase Authentication.
# Usa el mismo Firebase Project ID que mobile y backend.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: origen público de imágenes cuando difiere del origen de la API.
NEXT_PUBLIC_ASSETS_URL=
